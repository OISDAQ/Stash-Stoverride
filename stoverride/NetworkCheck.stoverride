name: 校园网体检
desc: 检测直连和代理，并在首页查看 Beszel 主机状态、CPU 和内存。
arguments-version: 1
arguments:
  target_url:
    type: input
    title: HTTPS 探测地址
    description: 默认探测 example.com。可换成 VPS 上带有效证书的 HTTPS 网页或健康检查地址。
    default: https://example.com/
    required: true
  proxy_name:
    type: input
    title: 代理节点或策略组
    description: 填写当前配置中的完整名称。留空只测直连。选策略组时请确认它当前使用代理节点。
    default: ''
  open_url:
    type: input
    title: 点击面板打开的网址
    description: 可以填写 Beszel 的 HTTPS 地址。留空时打开探测地址。
    default: ''
  beszel_hub:
    type: input
    title: Beszel Hub 地址
    description: 填写自己的 HTTPS 根地址。
    default: ''
  beszel_token:
    type: input
    title: Beszel 用户令牌
    description: 填写可查看主机的普通用户的 PocketBase 登录令牌。
    default: ''

tiles:
  - name: oisdaq-network-check
    title: 校园网体检
    content: 等待首次探测…
    icon: network
    backgroundColor: '#6945AA'
    interval: 600
    argument: '{"targetUrl":${args.target_url|json},"proxyName":${args.proxy_name|json},"openUrl":${args.open_url|json}}'
  - name: oisdaq-beszel-status
    title: 我的 VPS
    content: 等待首次读取…
    icon: server.rack
    interval: 60
    argument: '{"hub":${args.beszel_hub|json},"token":${args.beszel_token|json}}'

script-providers:
  oisdaq-network-check:
    interval: 86400
    payload: |
      const TITLE = "校园网体检";
      const TIMEOUT_SECONDS = 5;
      const COLORS = {
        ready: "#6945AA",
        warning: "#995309",
        failed: "#9D3949",
      };

      function isHttpsAddress(value) {
        return /^https:\/\/[^/?#@\s\\]+(?:[/?#][^\s\\]*)?$/i.test(value);
      }

      function readOptions() {
        try {
          const options = JSON.parse($argument);
          const targetUrl = options.targetUrl.trim();
          if (!isHttpsAddress(targetUrl)) {
            return { error: "请填写完整的 HTTPS 探测地址" };
          }

          const openUrl = options.openUrl.trim();
          if (openUrl && !isHttpsAddress(openUrl)) {
            return { error: "点击跳转地址需要以 https:// 开头" };
          }

          return {
            targetUrl,
            proxyName: options.proxyName.trim(),
            openUrl: openUrl || targetUrl,
          };
        } catch {
          return { error: "请在覆写详情中设置参数" };
        }
      }

      function measure(url, label, policy) {
        return new Promise((resolve) => {
          const startedAt = Date.now();
          $httpClient.get(
            {
              url,
              headers: {
                "X-Stash-Selected-Proxy": encodeURIComponent(policy),
                "Cache-Control": "no-cache",
              },
              timeout: TIMEOUT_SECONDS,
              "auto-cookie": false,
              "auto-redirect": false,
            },
            (error, response) => {
              const status = Number(response && (response.status || response.statusCode));
              if (status >= 100 && status <= 599) {
                const elapsed = Date.now() - startedAt;
                const healthy = status >= 200 && status < 400;
                const detail = healthy ? elapsed + " ms" : "HTTP " + status;
                resolve({ text: label + " · " + detail, reached: true, healthy });
                return;
              }

              const timedOut = /timed?\s*out|timeout|超时/i.test(String(error));
              resolve({
                text: label + (timedOut ? " · 超时" : " · 连接失败"),
                reached: false,
                healthy: false,
              });
            },
          );
        });
      }

      function localTime() {
        const now = new Date();
        const hour = String(now.getHours()).padStart(2, "0");
        const minute = String(now.getMinutes()).padStart(2, "0");
        return hour + ":" + minute;
      }

      async function buildTile() {
        const options = readOptions();
        if (options.error) {
          return {
            title: TITLE,
            content: options.error,
            icon: "exclamationmark.circle",
            backgroundColor: COLORS.warning,
          };
        }

        const probes = [measure(options.targetUrl, "直连", "DIRECT")];
        if (options.proxyName) {
          probes.push(measure(options.targetUrl, "代理", options.proxyName));
        }

        const results = await Promise.all(probes);
        const lines = results.map((result) => result.text);
        if (!options.proxyName) {
          lines.push("代理 · 未设置");
        }
        lines.push("更新于 " + localTime());

        let backgroundColor = COLORS.ready;
        if (!results.some((result) => result.reached)) {
          backgroundColor = COLORS.failed;
        } else if (!results.every((result) => result.healthy)) {
          backgroundColor = COLORS.warning;
        }

        return {
          title: TITLE,
          content: lines.join("\n"),
          icon: "network",
          backgroundColor,
          url: options.openUrl,
        };
      }

      buildTile().then(
        (tile) => $done(tile),
        () => $done({
          title: TITLE,
          content: "探测失败 · 请检查 Stash 脚本日志",
          icon: "exclamationmark.circle",
          backgroundColor: COLORS.failed,
        }),
      );
  oisdaq-beszel-status:
    interval: 86400
    payload: |
      function percent(value) {
        return Number.isFinite(value) ? Math.round(value) + "%" : "—";
      }

      function systemLine(system) {
        const name = system.name || "未命名";
        if (system.status === "up") {
          const info = system.info || {};
          return "🟢 " + name + " · CPU " + percent(info.cpu) + " · 内存 " + percent(info.mp);
        }
        const labels = { down: "🔴 离线", paused: "⏸ 已暂停", pending: "🟡 等待连接" };
        return (labels[system.status] || "⚪ 状态未知") + " · " + name;
      }

      async function getTile() {
        const options = JSON.parse($argument);
        const hub = options.hub.trim().replace(/\/+$/, "");
        const token = options.token.trim();
        if (!/^https:\/\/[a-z0-9.-]+(?::\d+)?$/i.test(hub) || !token) {
          return { content: "请在覆写参数中填写 Hub 的 HTTPS 地址和用户令牌" };
        }

        const cacheKey = "oisdaq-beszel-last-read:" + hub;
        const request = {
          url: hub + "/api/collections/systems/records?sort=name&fields=name,status,info&perPage=100",
          headers: { Authorization: token },
          timeout: 8,
          "auto-cookie": false,
          "auto-redirect": false,
        };
        const reply = await new Promise(resolve => {
          $httpClient.get(request, (error, response, data) => resolve({
            error, status: Number(response && (response.status || response.statusCode)), data,
          }));
        });
        function unavailable(reason) {
          const last = $persistentStore.read(cacheKey);
          return { content: reason + (last ? "\n上次成功读取 " + last : ""), url: hub };
        }
        if (reply.status === 401 || reply.status === 403) return unavailable("认证失败 · 请更新用户令牌");
        if (reply.error || reply.status !== 200) return unavailable("暂时无法读取 Hub · 请检查连接");
        let page;
        try { page = JSON.parse(reply.data); } catch { return unavailable("Hub 响应格式异常"); }
        if (!page || !Array.isArray(page.items)) return unavailable("Hub 未返回系统列表");
        if (!page.items.length) return unavailable("没有可见主机 · 请检查令牌及账号权限");

        const timestamp = new Date().toLocaleString("zh-CN", { hour12: false });
        $persistentStore.write(timestamp, cacheKey);
        const lines = page.items.map(systemLine);
        lines.push("更新于 " + timestamp);
        const color = page.items.some(s => s.status === "down") ? "#9D3949"
          : page.items.every(s => s.status === "up") ? "#30684D" : "#995309";
        return { content: lines.join("\n"), backgroundColor: color, url: hub };
      }

      getTile().then(
        tile => $done(Object.assign({ title: "我的 VPS", backgroundColor: "#995309" }, tile)),
        () => $done({ title: "我的 VPS", content: "暂时无法读取 · 请检查覆写参数", backgroundColor: "#995309" })
      );
